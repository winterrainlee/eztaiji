{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://winterrainlee.github.io/eztaiji/schemas/deployment.schema.json",
  "title": "eztaiji deployment contract 0.1.0 — preparation pilot",
  "type": "object",
  "properties": {
    "formatVersion": {
      "const": "0.1.0"
    },
    "profile": {
      "const": "preparation-pilot"
    },
    "meta": {
      "type": "object",
      "properties": {
        "datasetId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "datasetRevision": {
          "type": "string",
          "minLength": 1
        },
        "trainingSchemaVersion": {
          "type": "string",
          "minLength": 1
        },
        "generatorVersion": {
          "const": "0.1.0"
        },
        "inputDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "coverage": {
          "type": "object",
          "properties": {
            "kind": {
              "const": "partial"
            },
            "note": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "kind",
            "note"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "datasetId",
        "datasetRevision",
        "trainingSchemaVersion",
        "generatorVersion",
        "inputDigest",
        "coverage"
      ],
      "additionalProperties": false
    },
    "coordinateFrames": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]*$"
      },
      "additionalProperties": {
        "$ref": "common.schema.json#/$defs/frame"
      }
    },
    "catalog": {
      "type": "object",
      "properties": {
        "sections": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9-]*$"
                  },
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "kind": {
                    "const": "postures"
                  },
                  "order": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "postureIds": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9-]*$"
                    },
                    "uniqueItems": true
                  }
                },
                "required": [
                  "id",
                  "name",
                  "kind",
                  "order",
                  "postureIds"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "id": {
                    "const": "principles"
                  },
                  "name": {
                    "const": "공통원리"
                  },
                  "kind": {
                    "const": "principles"
                  },
                  "order": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "principleIds": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9-]*$"
                    },
                    "uniqueItems": true
                  },
                  "viewIds": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9-]*$"
                    },
                    "uniqueItems": true
                  }
                },
                "required": [
                  "id",
                  "name",
                  "kind",
                  "order",
                  "principleIds",
                  "viewIds"
                ],
                "additionalProperties": false
              }
            ]
          }
        },
        "postures": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]*$"
              },
              "number": {
                "type": "integer",
                "minimum": 1
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "motionCount": {
                "type": "integer",
                "minimum": 0
              },
              "startViewId": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]*$"
              },
              "motionViewIds": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9-]*$"
                },
                "uniqueItems": true
              }
            },
            "required": [
              "id",
              "number",
              "name",
              "motionCount",
              "startViewId",
              "motionViewIds"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "sections",
        "postures"
      ],
      "additionalProperties": false
    },
    "navigation": {
      "type": "object",
      "properties": {
        "order": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "uniqueItems": true
        },
        "edges": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "previous": {
                "oneOf": [
                  {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9-]*$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "next": {
                "oneOf": [
                  {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9-]*$"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "previous",
              "next"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "order",
        "edges"
      ],
      "additionalProperties": false
    },
    "states": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]*$"
      },
      "additionalProperties": {
        "$ref": "common.schema.json#/$defs/state"
      }
    },
    "views": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]*$"
      },
      "additionalProperties": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]*$"
              },
              "kind": {
                "enum": [
                  "start",
                  "motion"
                ]
              },
              "postureId": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]*$"
              },
              "motionId": {
                "oneOf": [
                  {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9-]*$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "motionNumber": {
                "oneOf": [
                  {
                    "type": "integer",
                    "minimum": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "title": {
                "type": "string",
                "minLength": 1
              },
              "stateId": {
                "oneOf": [
                  {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9-]*$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "fromStateId": {
                "oneOf": [
                  {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9-]*$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "instruction": {
                "$ref": "common.schema.json#/$defs/textClaim"
              },
              "checks": {
                "type": "array",
                "items": {
                  "$ref": "common.schema.json#/$defs/textClaim"
                }
              },
              "events": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9-]*$"
                    },
                    "target": {
                      "enum": [
                        "leftFoot",
                        "rightFoot",
                        "body",
                        "center",
                        "leftArm",
                        "rightArm"
                      ]
                    },
                    "kind": {
                      "enum": [
                        "heel_raise",
                        "heel_lower",
                        "foot_move",
                        "foot_turn",
                        "weight_shift",
                        "arm_move",
                        "body_lower"
                      ]
                    },
                    "description": {
                      "$ref": "common.schema.json#/$defs/textClaim"
                    },
                    "symbol": {
                      "enum": [
                        "Heel ↑",
                        "Heel ↓",
                        null
                      ]
                    }
                  },
                  "required": [
                    "id",
                    "target",
                    "kind",
                    "description",
                    "symbol"
                  ],
                  "additionalProperties": false
                }
              },
              "contactSymbols": {
                "type": "object",
                "properties": {
                  "left": {
                    "enum": [
                      "Toe",
                      "Heel",
                      null
                    ]
                  },
                  "right": {
                    "enum": [
                      "Toe",
                      "Heel",
                      null
                    ]
                  }
                },
                "required": [
                  "left",
                  "right"
                ],
                "additionalProperties": false
              },
              "interpretationIds": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9-]*$"
                },
                "uniqueItems": true
              },
              "sourceIds": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9-]*$"
                },
                "uniqueItems": true
              },
              "principleIds": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9-]*$"
                },
                "uniqueItems": true
              }
            },
            "required": [
              "id",
              "kind",
              "postureId",
              "motionId",
              "motionNumber",
              "title",
              "stateId",
              "fromStateId",
              "instruction",
              "checks",
              "events",
              "contactSymbols",
              "interpretationIds",
              "sourceIds"
            ],
            "additionalProperties": false,
            "allOf": [
              {
                "if": {
                  "properties": {
                    "kind": {
                      "const": "start"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "motionId": {
                      "type": "null"
                    },
                    "motionNumber": {
                      "type": "null"
                    },
                    "fromStateId": {
                      "type": "null"
                    },
                    "events": {
                      "maxItems": 0
                    }
                  }
                }
              }
            ]
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]*$"
              },
              "kind": {
                "const": "principle"
              },
              "principleId": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]*$"
              },
              "title": {
                "type": "string",
                "minLength": 1
              },
              "order": {
                "type": "integer",
                "minimum": 1
              },
              "summary": {
                "$ref": "common.schema.json#/$defs/textClaim"
              },
              "explanation": {
                "$ref": "common.schema.json#/$defs/textClaim"
              },
              "example": {
                "oneOf": [
                  {
                    "$ref": "common.schema.json#/$defs/textClaim"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "sourceIds": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9-]*$"
                },
                "uniqueItems": true
              }
            },
            "required": [
              "id",
              "kind",
              "principleId",
              "title",
              "order",
              "summary",
              "explanation",
              "example",
              "sourceIds"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    "interpretations": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]*$"
      },
      "additionalProperties": {
        "$ref": "common.schema.json#/$defs/interpretation"
      }
    },
    "sources": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]*$"
      },
      "additionalProperties": {
        "$ref": "common.schema.json#/$defs/publicSource"
      }
    },
    "principles": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]*$"
      },
      "additionalProperties": {
        "$ref": "common.schema.json#/$defs/principle"
      }
    }
  },
  "required": [
    "formatVersion",
    "profile",
    "meta",
    "coordinateFrames",
    "catalog",
    "navigation",
    "states",
    "views",
    "interpretations",
    "sources"
  ],
  "additionalProperties": false
}
